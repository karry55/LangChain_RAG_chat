{
  "permissions": {
    "allow": [
      "Bash(python -m *)",
      "Bash(pip install *)",
      "Bash(curl *)",
      "Bash(taskkill *)",
      "Bash(powershell *)",
      "Bash(cd *backend* && *)",
      "Bash(cd *frontend* && *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(start http://localhost:*)",
      "Bash(mkdir *)",
      "Bash(rm *)",
      "Bash(cp *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(sleep *)",
      "Bash(export *)",
      "Bash(echo *)",
      "Bash(git *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR}\" && python -m pytest backend/tests/ -q --tb=no 2>&1 || echo '⚠️ 后端测试未通过，建议先修复再提交'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '💡 提示：后端和前端可能仍在运行。如需停止：taskkill //F //IM python.exe //IM node.exe'"
          }
        ]
      }
    ]
  }
}
